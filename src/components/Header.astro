---
import Phone from "@lucide/astro/icons/phone";
import Menu from "@lucide/astro/icons/menu";
import { nav, site } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 bg-card/95 shadow-[0_1px_8px_rgb(10_25_47/0.06)] backdrop-blur-md">
  <div class="page flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex flex-col leading-tight">
      <span class="text-lg font-semibold tracking-tight text-navy">Wolf Autó</span>
      <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-muted">Szombathely</span>
    </a>

    <nav
      id="main-menu"
      popover
      aria-label="Főmenü"
      class="fixed top-[4.5rem] right-4 bottom-auto left-auto m-0 w-56 flex-col overflow-visible rounded-xl border-0 bg-card p-2 shadow-lift ring-1 ring-border-subtle open:flex lg:static lg:flex lg:w-auto lg:flex-row lg:items-center lg:gap-6 lg:rounded-none lg:bg-transparent lg:p-0 lg:shadow-none lg:ring-0"
    >
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-2.5 font-medium text-navy transition-colors hover:bg-subtle lg:rounded-none lg:p-0 lg:font-normal lg:text-muted lg:hover:bg-transparent lg:hover:text-primary"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.phone.href} class="btn btn-primary !min-h-10 !px-4 !py-2 !text-[15px]">
        <Phone size={18} aria-hidden="true" />
        <span>
          Hívás<span class="max-sm:hidden">: {site.phone.display}</span>
        </span>
      </a>

      <button
        type="button"
        popovertarget="main-menu"
        class="flex size-10 cursor-pointer items-center justify-center rounded-lg bg-subtle text-navy lg:hidden"
        aria-label="Menü"
      >
        <Menu size={22} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>
