---
import IdCard from "@lucide/astro/icons/id-card";
import MapPin from "@lucide/astro/icons/map-pin";
import Smartphone from "@lucide/astro/icons/smartphone";
import { nav, site } from "../data/site";

const badge =
  "flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary-bright/10 text-primary";
const hover = "transition-colors group-hover:bg-primary-bright group-hover:text-white";
---

<footer class="bg-card shadow-[0_-4px_24px_rgb(10_25_47/0.03)]">
  <div class="page grid gap-10 py-16 md:grid-cols-3">
    <div class="flex flex-col gap-4">
      <span class="text-[22px] font-semibold text-navy">Wolf Autó</span>
      <p class="text-[13px] leading-5 text-muted">
        Eredetvizsgálat, gépjárműátírás és ingyenes biztosításkötés Szombathelyen, sorban állás
        nélkül.
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <span class="text-lg font-semibold text-navy">Oldalak</span>
      <ul class="flex flex-col gap-1">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-muted hover:text-primary">
              {item.footerLabel}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="flex flex-col gap-4">
      <span class="text-lg font-semibold text-navy">Elérhetőség</span>
      <address class="flex flex-col gap-3 text-sm not-italic text-muted">
        <div class="flex items-center gap-3">
          <span class={badge}>
            <IdCard size={18} stroke-width={1.75} aria-hidden="true" />
          </span>
          {site.owner}
        </div>
        <a
          href={site.mapUrl}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-3 transition-colors hover:text-primary"
        >
          <span class:list={[badge, hover]}>
            <MapPin size={18} stroke-width={1.75} aria-hidden="true" />
          </span>
          {site.address.full}
        </a>
        <a
          href={site.phone.href}
          class="group flex items-center gap-3 transition-colors hover:text-primary"
        >
          <span class:list={[badge, hover]}>
            <Smartphone size={18} stroke-width={1.75} aria-hidden="true" />
          </span>
          {site.phone.display}
        </a>
      </address>
    </div>
  </div>
  <div class="page border-t border-subtle py-6 text-[13px] text-muted">
    <p>
      © {new Date().getFullYear()} {site.name}
    </p>
  </div>
</footer>
