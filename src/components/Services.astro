---
import CircleCheck from "@lucide/astro/icons/circle-check";
import Clock from "@lucide/astro/icons/clock";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { services } from "../data/site";
---

<section id="services" class="section">
  <div class="page">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="eyebrow mb-1">Szolgáltatások</span>
      <h2 class="h2 mb-1">Eredetvizsgálat, gépjárműátírás, biztosításkötés Szombathelyen</h2>
      <p class="text-muted">Átlátható árak, egyetlen telephelyen.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {services.map((s) => (
        <article class="card relative flex flex-col justify-between overflow-hidden p-10 hover:shadow-lift max-sm:p-6">
          <div class={`absolute inset-x-0 top-0 h-1 ${s.accent}`} />
          <div>
            <div class="mb-2 flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-muted">
                {s.eyebrow}
              </span>{" "}
              <span class="chip">
                <Clock size={16} aria-hidden="true" />
                {s.duration}
              </span>
            </div>
            <h3 class="mb-1 text-lg font-semibold text-navy">{s.title}</h3>
            <div class="my-4 pb-2">
              <p
                class:list={[
                  "text-[32px] leading-9 font-bold tracking-[-0.02em] tabular-nums",
                  s.price === "0" ? "text-success-ink" : "text-navy",
                ]}
              >
                {s.price} <span class="text-[22px] font-semibold text-muted">{s.unit}</span>
              </p>
              <span class="text-[13px] text-muted">{s.note}</span>
            </div>
            <div class="my-2 h-px bg-subtle" />
            <ul class="mt-4 flex flex-col gap-2">
              {s.items.map((item) => (
                <li class="flex items-start gap-1">
                  <CircleCheck size={20} class={`mt-0.5 shrink-0 ${s.check}`} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-4 pt-10">
            <a
              href={`/services/#${s.id}`}
              class:list={[
                "btn w-full",
                s.id === "origin-inspection" ? "btn-primary" : "btn-ghost",
              ]}
            >
              Részletek
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
