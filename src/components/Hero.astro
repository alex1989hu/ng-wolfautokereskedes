---
import Timer from "@lucide/astro/icons/timer";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Handshake from "@lucide/astro/icons/handshake";
import BadgeCheck from "@lucide/astro/icons/badge-check";

const badges = [
  { icon: Timer, label: "Eredetvizsgálat ~30 perc alatt", tone: "text-primary-bright" },
  { icon: ShieldCheck, label: "Hatósági bizonyítvány", tone: "text-success" },
  { icon: Handshake, label: "12 biztosító partnere", tone: "text-primary-bright" },
];
---

<section id="top" class="relative overflow-hidden pb-16 pt-28">
  <div class="pointer-events-none absolute -right-36 -top-36 size-96 rounded-full bg-primary-tint/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-20 top-1/2 size-80 rounded-full bg-secondary-container/40 blur-3xl"></div>

  <div class="page relative z-10">
    <div class="flex max-w-3xl flex-col items-start gap-4">
      <span class="inline-flex items-center gap-1 rounded-full bg-surface-container px-4 py-1 text-[11px] font-bold uppercase tracking-[0.08em] text-primary shadow-sm">
        <BadgeCheck size={16} aria-hidden="true" />
        Eredetvizsgálat · Szombathely
      </span>
      <h1 class="text-4xl font-bold leading-tight tracking-[-0.025em] text-navy lg:text-[56px] lg:leading-16 lg:tracking-[-0.03em]">
        Eredetvizsgálat és gyors járműügyintézés Szombathelyen
      </h1>
      <p class="max-w-2xl text-[17px] leading-relaxed text-muted">
        Teljes körű járműügyintézés egy helyen: eredetvizsgálat, gépjárműátírás és ingyenes
        biztosításkötés, sorban állás nélkül.
      </p>

      <ul class="flex flex-wrap gap-2 pt-1">
        {badges.map(({ icon: Icon, label, tone }) => (
          <li class="flex items-center gap-1 rounded-lg bg-card px-4 py-1 text-sm font-medium text-navy shadow-sm">
            <Icon size={20} class={tone} aria-hidden="true" />
            {label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
