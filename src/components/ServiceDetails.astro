---
import CircleCheck from "@lucide/astro/icons/circle-check";
import Clock from "@lucide/astro/icons/clock";
import Phone from "@lucide/astro/icons/phone";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import { faqs, originInspectionPrices, services, site } from "../data/site";
---

<div>
  {services.map((s, index) => {
    const related = faqs.filter((f) => (f.topics as readonly string[]).includes(s.id));
    return (
      <section id={s.id} class:list={["section", index % 2 === 0 ? "bg-card" : ""]}>
        <div class="page grid items-start gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <span class="eyebrow mb-1">{s.eyebrow}</span>
            <h2 class="h2">{s.title} Szombathelyen</h2>
            <p class="mt-3 text-[17px] leading-relaxed text-muted">{s.intro}</p>
            <ul class="mt-6 flex flex-col gap-2">
              {s.items.map((item) => (
                <li class="flex items-start gap-1">
                  <CircleCheck size={20} class={`mt-0.5 shrink-0 ${s.check}`} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            {related.length > 0 && (
              <div class="mt-8 flex flex-col gap-2">
                <h3 class="font-semibold text-navy">{s.title} – gyakori kérdések</h3>
                {related.map((faq) => (
                  <details class="card group p-4 open:shadow-lift">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy [&::-webkit-details-marker]:hidden">
                      {faq.q}
                      <ChevronDown
                        size={20}
                        class="shrink-0 text-muted transition-transform group-open:rotate-180"
                        aria-hidden="true"
                      />
                    </summary>
                    <p class="mt-2 border-t border-subtle pt-2 text-muted">{faq.a}</p>
                  </details>
                ))}
              </div>
            )}
          </div>

          <aside class="card relative overflow-hidden p-8 lg:col-span-5">
            <div class={`absolute inset-x-0 top-0 h-1 ${s.accent}`} />
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-[0.08em] text-muted">Ár</span>
              <span class="chip">
                <Clock size={16} aria-hidden="true" />
                {s.duration}
              </span>
            </div>
            <p
              class:list={[
                "mt-2 text-[32px] leading-9 font-bold tracking-[-0.02em] tabular-nums",
                s.price === "0" ? "text-success-ink" : "text-navy",
              ]}
            >
              {s.price} <span class="text-[22px] font-semibold text-muted">{s.unit}</span>
            </p>
            <span class="text-[13px] text-muted">{s.note}</span>

            {s.id === "origin-inspection" && (
              <dl class="mt-4 flex flex-col gap-2 border-t border-subtle pt-4">
                {originInspectionPrices.map((row) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-muted">{row.detail}</dt>
                    <dd class="font-semibold tabular-nums text-navy">{row.price}</dd>
                  </div>
                ))}
              </dl>
            )}

            <div class="mt-6 flex flex-col gap-2">
              <a href={site.phone.href} class="btn btn-primary">
                <Phone size={20} aria-hidden="true" />
                {s.callLabel}
              </a>
              {s.id === "origin-inspection" && (
                <a href="/pricing/" class="btn btn-ghost">
                  Összes ár
                </a>
              )}
            </div>
          </aside>
        </div>
      </section>
    );
  })}
</div>
