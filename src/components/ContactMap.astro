---
import Phone from "@lucide/astro/icons/phone";
import MapPin from "@lucide/astro/icons/map-pin";
import IdCard from "@lucide/astro/icons/id-card";
import Navigation from "@lucide/astro/icons/navigation";
import Clock from "@lucide/astro/icons/clock";
import { openingHours, site } from "../data/site";

const embedUrl = `https://www.google.com/maps?q=${encodeURIComponent(site.address.full)}&output=embed`;

interface Props {
  /** Render the heading as the page's h1 instead of an h2. */
  asPage?: boolean;
}

const { asPage = false } = Astro.props;
const Heading = asPage ? "h1" : "h2";
---

<section id="contact" class="section bg-card">
  <div class="page">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="eyebrow mb-1">Elérhetőség</span>
      <Heading class="h2">Kapcsolat & Telephely</Heading>
      <p class="mt-1 text-muted">
        Keressen minket telefonon, vagy látogasson el hozzánk: a telephely Szombathelyen, a Farkas
        Károly utcában található.
      </p>
    </div>

    <div class="grid items-stretch gap-10 lg:grid-cols-12">
      <div class="card flex flex-col gap-4 rounded-2xl bg-canvas p-10 shadow-md max-sm:p-6 lg:col-span-5">
        <h2 class="text-[22px] leading-7 font-semibold tracking-[-0.01em] text-navy">
          Hívjon bizalommal
        </h2>
        <a href={site.phone.href} class="btn btn-primary text-lg">
          <Phone size={22} aria-hidden="true" />
          {site.phone.display}
        </a>
        <ul class="flex flex-col gap-3 pt-2 font-semibold text-navy">
          <li class="flex items-center gap-2">
            <IdCard size={20} class="text-primary" aria-hidden="true" />
            {site.owner}
          </li>
          <li class="flex items-start gap-2">
            <MapPin size={20} class="mt-0.5 shrink-0 text-primary" aria-hidden="true" />
            <span>
              {site.address.full}{" "}
              <span class="mt-1 block text-[13px] font-normal text-muted">
                {site.address.landmark}
              </span>
            </span>
          </li>
        </ul>
        <div class="mt-2 border-t border-border-subtle pt-4">
          <h2 class="mb-2 flex items-center gap-2 font-semibold text-navy">
            <Clock size={20} class="text-primary" aria-hidden="true" />
            Nyitvatartás
          </h2>
          <dl class="flex flex-col gap-1">
            {openingHours.map(({ label, hours }) => (
              <div class="flex justify-between gap-4">
                <dt class="text-muted">{label}</dt>
                <dd class="font-semibold tabular-nums text-navy">
                  {hours ? `${hours.opens.replace(/^0/, "")} – ${hours.closes}` : "Zárva"}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="flex flex-col gap-4 lg:col-span-7">
        <iframe
          title="Térkép: Wolf Autókereskedés, Szombathely"
          src={embedUrl}
          class="h-80 w-full flex-1 rounded-2xl border-0 shadow-md"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a href={site.mapUrl} target="_blank" rel="noopener" class="btn btn-ghost">
          <Navigation size={20} aria-hidden="true" />
          Útvonaltervezés
        </a>
      </div>
    </div>
  </div>
</section>
