---
import Gauge from "@lucide/astro/icons/gauge";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import Network from "@lucide/astro/icons/network";
import Handshake from "@lucide/astro/icons/handshake";
import ProcessSteps from "./ProcessSteps.astro";

const reasons = [
  {
    icon: Gauge,
    title: "Gyors vizsgálat",
    text: "Az eredetvizsgálat nagyjából 30 perc, a biztosításkötés körülbelül 20 perc.",
  },
  {
    icon: BadgeCheck,
    title: "Hatósági bizonyítvány",
    text: "A kiállított bizonyítvány 60 napig felhasználható gépjárműve átírásához.",
  },
  {
    icon: Network,
    title: "Egyablakos ügyintézés",
    text: "Eredetvizsgálat, biztosításkötés és okmányirodai átírás egy helyen.",
  },
  {
    icon: Handshake,
    title: "12 biztosító partnere",
    text: "Kiválasztjuk Önnek a legkedvezőbb ajánlatot, a biztosításkötés ingyenes.",
  },
];
---

<section id="why-us" class="section">
  <div class="page">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="eyebrow mb-1">Miért mi?</span>
      <h2 class="h2">Miért válassza a Wolf Autókereskedést?</h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {reasons.map(({ icon: Icon, title, text }) => (
        <div class="card flex flex-col items-start gap-2 p-6 hover:shadow-lift">
          <div class="flex size-12 items-center justify-center rounded-lg bg-surface-container text-primary">
            <Icon size={28} aria-hidden="true" />
          </div>
          <h3 class="text-lg font-semibold text-navy">{title}</h3>
          <p class="text-[13px] leading-[18px] text-muted">{text}</p>
        </div>
      ))}
    </div>

    <ProcessSteps />
  </div>
</section>
