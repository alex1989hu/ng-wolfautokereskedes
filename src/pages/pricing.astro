---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PricingTable from "../components/PricingTable.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  breadcrumbs={[{ name: "Árak", path: "/pricing/" }]}
  title="Eredetvizsgálat ára Szombathelyen – Árak | Wolf Autókereskedés"
  description="Eredetvizsgálat ára Szombathelyen: 22 950 Ft-tól hengerűrtartalom szerint. Gépjárműátírás 5 000 – 10 000 Ft, a biztosításkötés ingyenes."
>
  <Header />
  <main class="pt-20">
    <PricingTable asPage />
  </main>
  <Footer />
</Layout>
